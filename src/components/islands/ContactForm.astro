---
// src/components/islands/ContactForm.astro
interface Props {
  labels: {
    name: string;
    email: string;
    message: string;
    send: string;
  };
}

const { labels } = Astro.props;
---

<div class="contact-form-wrapper">
  <form id="form" class="contact-form">
    <input type="hidden" name="access_key" value="ee8c63ec-5c21-44e6-9472-a08f3075757e" />
    
    <div class="form-group">
      <label for="name">{labels.name} *</label>
      <input type="text" id="name" name="name" required class="form-control" />
    </div>

    <div class="form-group">
      <label for="email">{labels.email} *</label>
      <input type="email" id="email" name="email" required class="form-control" />
    </div>

    <div class="form-group">
      <label for="message">{labels.message} *</label>
      <textarea id="message" name="message" rows="5" required class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary submit-btn">{labels.send}</button>
    <div id="result" class="form-result"></div>
  </form>
</div>

<script>
  const form = document.getElementById("form") as HTMLFormElement;
  const result = document.getElementById("result") as HTMLElement;

  if (form && result) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      result.style.color = "#0b66c2";
      result.innerHTML = "Sending...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          result.style.color = "var(--color-success, #16a34a)";
          result.innerHTML = "Form Submitted Successfully";
          form.reset();
        } else {
          result.style.color = "#dc2626";
          result.innerHTML = data.message;
        }
      } catch (error) {
        result.style.color = "#dc2626";
        result.innerHTML = "Something went wrong. Please try again.";
      }
    });
  }
</script>

<style>
  .contact-form {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1e293b;
    margin-bottom: 0.4rem;
  }
  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius, 0.375rem);
    font-size: 1rem;
    color: #334155;
    background-color: #f8fafc;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(11, 102, 194, 0.15);
  }
  textarea.form-control {
    resize: vertical;
  }
  .submit-btn {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.85rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
  }
  .form-result {
    margin-top: 1rem;
    font-weight: 600;
    text-align: center;
    font-size: 0.95rem;
  }
</style>
