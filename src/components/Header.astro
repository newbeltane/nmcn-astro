---
import { localizedPath, useTranslations, type Locale } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const navItems = [
  { href: localizedPath(locale, '/'), label: t('nav.home') },
  { 
    href: localizedPath(locale, '/who-we-are'), 
    label: t('nav.about') !== 'nav.about' ? t('nav.about') : 'About',
    dropdown: [
      { href: localizedPath(locale, '/who-we-are'), label: t('nav.whoWeAre') || 'Who We Are' },
      { href: localizedPath(locale, '/what-we-do'), label: t('nav.whatWeDo') || 'What We Do' },
    ]
  },
  { href: localizedPath(locale, '/news'), label: t('nav.news') },
  { href: localizedPath(locale, '/contact'), label: t('nav.contact') },
];

const donateHref = localizedPath(locale, '/donate');

const siteName = t('site.name') !== 'site.name' ? t('site.name') : 'National Mission Commission of Nepal';
const siteStrapline = t('site.strapline') !== 'site.strapline' ? t('site.strapline') : 'Training & equipping to reach out the unreached';
---

<!-- Sticky Top Navigation Bar -->
<header class="nav-bar">
  <div class="container header-container">
    <a href={localizedPath(locale, '/')} class="brand" aria-label="NMCN Home">
      <Logo />
    </a>

    <nav class="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class={`nav-item ${item.dropdown ? 'has-dropdown' : ''}`}>
            <a href={item.href} class="nav-link">
              {item.label}
              {item.dropdown && <span class="arrow" aria-hidden="true">▾</span>}
            </a>
            {item.dropdown && (
              <ul class="dropdown-menu">
                {item.dropdown.map((sub) => (
                  <li>
                    <a href={sub.href} class="dropdown-link">{sub.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher locale={locale} />
      <a href={donateHref} class="btn btn-primary donate-btn">{t('nav.donate')}</a>
    </div>
  </div>
</header>

<!-- Lower Banner Strip: Scrolls away with the page -->
<aside class="lower-header-strip">
  <div class="container lower-header-container">
    <div class="strip-text">
      <h1 class="strip-title">{siteName}</h1>
      <p class="strip-strapline">{siteStrapline}</p>
    </div>
  </div>
</aside>

<style>
  /* Sticky Top Navigation Bar */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.35rem;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--color-primary);
  }

  .arrow {
    font-size: 0.8rem;
    line-height: 1;
  }

  /* Dropdown Styles */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: var(--shadow);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0.5rem 0 0 0;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  }

  .nav-item.has-dropdown:hover .dropdown-menu,
  .nav-item.has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 1.25rem;
    color: #334155;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover {
    background-color: #f1f5f9;
    color: var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .donate-btn {
    font-weight: 700;
    padding: 0.45rem 1.2rem;
  }

  /* Centered Lower Header Section */
  .lower-header-strip {
    width: 100%;
    background-color: #f8fafc;
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.6rem;
  }

  .lower-header-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .strip-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.15rem;
  }

  .strip-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .strip-strapline {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .lower-header-strip {
      display: none;
    }
  }
</style>
