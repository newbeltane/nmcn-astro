---
import { localizedPath, useTranslations, type Locale } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const navItems = [
  { href: localizedPath(locale, '/'), label: t('nav.home') },
  { 
    href: localizedPath(locale, '/who-we-are'), 
    label: t('nav.about') !== 'nav.about' ? t('nav.about') : 'About',
    dropdown: [
      { href: localizedPath(locale, '/who-we-are'), label: t('nav.whoWeAre') || 'Who We Are' },
      { href: localizedPath(locale, '/what-we-do'), label: t('nav.whatWeDo') || 'What We Do' },
    ]
  },
  { href: localizedPath(locale, '/news'), label: t('nav.news') },
  { href: localizedPath(locale, '/contact'), label: t('nav.contact') },
];

const donateHref = localizedPath(locale, '/donate');

const siteName = t('site.name') !== 'site.name' ? t('site.name') : 'National Mission Commission of Nepal';
const siteStrapline = t('site.strapline') !== 'site.strapline' ? t('site.strapline') : 'Training & equipping to reach out the unreached';
---

<!-- Sticky Top Navigation Bar -->
<header class="nav-bar">
  <div class="container header-container">
    <a href={localizedPath(locale, '/')} class="brand" aria-label="NMCN Home">
      <Logo />
    </a>

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-toggle" aria-label="Toggle Menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>

    <!-- Wrapper for nav and actions to collapse on mobile -->
    <div class="nav-wrapper">
      <nav class="main-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li class={`nav-item ${item.dropdown ? 'has-dropdown' : ''}`}>
              <a href={item.href} class="nav-link">
                {item.label}
                {item.dropdown && <span class="arrow" aria-hidden="true">▾</span>}
              </a>
              {item.dropdown && (
                <ul class="dropdown-menu">
                  {item.dropdown.map((sub) => (
                    <li>
                      <a href={sub.href} class="dropdown-link">{sub.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <LanguageSwitcher locale={locale} />
        <a href={donateHref} class="btn btn-primary donate-btn">{t('nav.donate')}</a>
      </div>
    </div>
  </div>
</header>

<!-- Lower Banner Strip: Scrolls away with the page -->
<aside class="lower-header-strip">
  <div class="container lower-header-container">
    <div class="strip-text">
      <h1 class="strip-title">{siteName}</h1>
      <p class="strip-strapline">{siteStrapline}</p>
    </div>
  </div>
</aside>

<script>
  // Setup client-side interactivity for the mobile menu
  function setupMobileMenu() {
    const mobileToggle = document.querySelector('.mobile-toggle');
    const navWrapper = document.querySelector('.nav-wrapper');
    
    if (mobileToggle && navWrapper) {
      // Clean up previous event listeners if Astro view transitions are used
      const newToggle = mobileToggle.cloneNode(true);
      mobileToggle.parentNode?.replaceChild(newToggle, mobileToggle);
      
      newToggle.addEventListener('click', () => {
        newToggle.classList.toggle('is-active');
        navWrapper.classList.toggle('is-active');
        
        const isExpanded = newToggle.getAttribute('aria-expanded') === 'true';
        newToggle.setAttribute('aria-expanded', String(!isExpanded));
      });
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

<style>
  /* Sticky Top Navigation Bar */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.35rem;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* Mobile Toggle Styles */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
    z-index: 1001;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: #1e293b;
    position: relative;
    transition: background 0.2s;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    background: #1e293b;
    transition: transform 0.2s, top 0.2s;
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }

  .mobile-toggle.is-active .hamburger { background: transparent; }
  .mobile-toggle.is-active .hamburger::before { top: 0; transform: rotate(45deg); }
  .mobile-toggle.is-active .hamburger::after { top: 0; transform: rotate(-45deg); }

  /* Desktop Wrapper */
  @media (min-width: 769px) {
    .nav-wrapper {
      display: contents;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--color-primary);
  }

  .arrow {
    font-size: 0.8rem;
    line-height: 1;
  }

  /* Dropdown Styles */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: var(--shadow);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0.5rem 0 0 0;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  }

  .nav-item.has-dropdown:hover .dropdown-menu,
  .nav-item.has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 1.25rem;
    color: #334155;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover {
    background-color: #f1f5f9;
    color: var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .donate-btn {
    font-weight: 700;
    padding: 0.45rem 1.2rem;
  }

  /* Centered Lower Header Section */
  .lower-header-strip {
    width: 100%;
    background-color: #f8fafc;
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.6rem;
  }

  .lower-header-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .strip-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.15rem;
  }

  .strip-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .strip-strapline {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.2;
  }

  /* Mobile Overrides */
  @media (max-width: 768px) {
    .lower-header-strip {
      display: none;
    }
    
    .mobile-toggle {
      display: block;
    }

    .nav-wrapper {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
      gap: 1.5rem;
      
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
    }

    .nav-wrapper.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      width: 100%;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid var(--color-border);
      border-radius: 0;
      padding: 0;
      margin: 0.5rem 0 0 1rem;
      min-width: auto;
      display: none;
    }

    .nav-item.has-dropdown:hover .dropdown-menu,
    .nav-item.has-dropdown:focus-within .dropdown-menu {
      display: block;
    }

    .header-actions {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
      gap: 1rem;
    }
  }
</style>