---
import { languages, switchLocalePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entries = Object.entries(languages) as [Locale, string][];
---

<div class="lang-switcher" role="group" aria-label="Language selector">
  {
    entries.map(([code, label]) => (
      <a
        href={switchLocalePath(Astro.url, code)}
        class={`lang-link ${code === locale ? 'active' : ''}`}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? 'true' : undefined}
      >
        {code.toUpperCase()}
        <span class="visually-hidden">{label}</span>
      </a>
    ))
  }
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.15rem;
    background: #fff;
  }
  .lang-link {
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
    color: var(--color-muted);
    line-height: 1;
    text-decoration: none;
  }
  .lang-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-navy);
    text-decoration: none;
  }
  .lang-link.active {
    background: var(--color-primary);
    color: #fff;
  }
</style>
