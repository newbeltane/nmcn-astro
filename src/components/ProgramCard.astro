---
interface Props {
  title: string;
  location?: string;
  established?: number;
  description: string;
  image: string;
  imageAlt?: string;
  href?: string;
  linkLabel?: string;
}
const { title, location, established, description, image, imageAlt, href, linkLabel } = Astro.props;
---

<article class="card program-card">
  <img src={image} alt={imageAlt ?? title} width="640" height="400" loading="lazy" />
  <div class="card-body">
    <h3>{title}</h3>
    {
      (location || established) && (
        <p class="program-meta">
          {location}
          {location && established ? ' · ' : ''}
          {established ? `Est. ${established}` : ''}
        </p>
      )
    }
    <p class="program-desc">{description}</p>
    {
      href && (
        <a href={href} class="program-link">
          {linkLabel ?? 'Learn more'}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .program-meta {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
    margin: 0;
  }
  .program-desc { color: var(--color-body); margin: 0; }
  .program-link { font-weight: 600; margin-top: auto; display: inline-flex; gap: 0.35rem; }
</style>
