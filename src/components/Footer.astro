---
import { localizedPath, useTranslations, type Locale } from '../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: localizedPath(locale, '/who-we-are'), label: locale === 'ne' ? 'हामी को हौँ' : (t('nav.whoWeAre') || 'Who We Are') },
  { href: localizedPath(locale, '/what-we-do'), label: locale === 'ne' ? 'हामी के गर्छौं' : (t('nav.whatWeDo') || 'What We Do') },
  { href: localizedPath(locale, '/news'), label: t('nav.news') },
  { href: localizedPath(locale, '/donate'), label: t('nav.donate') },
  { href: localizedPath(locale, '/contact'), label: t('nav.contact') },
];

const addressLines = locale === 'ne' 
  ? ['पो.ब.नं. ८९७५, ईपीसी-८३०', 'काठमाडौँ, नेपाल'] 
  : ['P.O. Box 8975, EPC-830', 'Kathmandu, NEPAL'];

const siteName = locale === 'ne' 
  ? 'नेसनल मिसन कमिसन नेपाल' 
  : (t('site.name') !== 'site.name' ? t('site.name') : 'National Mission Commission of Nepal');

const rightsNotice = locale === 'ne'
  ? `© ${currentYear} ${siteName}। सर्वाधिकार सुरक्षित।`
  : `© ${currentYear} ${siteName}. ${t('footer.rights') || 'All rights reserved.'}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand / About Column -->
    <div class="footer-col brand-col">
      <div class="footer-brand">
        <div class="footer-logo-wrapper">
          <Logo />
        </div>
        <h3 class="footer-site-name">{siteName}</h3>
      </div>
      <p class="footer-about-text">
        {t('footer.about')}
      </p>
      <div class="social-links">
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-link">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>

    <!-- Quick Links Column -->
    <div class="footer-col links-col">
      <h4 class="footer-heading">{t('footer.quickLinks')}</h4>
      <ul class="footer-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact Column -->
    <div class="footer-col contact-col">
      <h4 class="footer-heading">{t('footer.contact')}</h4>
      <div class="footer-contact-details">
        {addressLines.map((line) => (
          <p class="contact-line">{line}</p>
        ))}
        <p class="contact-line">
          <a href="tel:+97715591706" class="contact-link">+977 1 5591706</a>
        </p>
        <p class="contact-line">
          <a href="mailto:nmcn2001@gmail.com" class="contact-link">nmcn2001@gmail.com</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Fully Localized Copyright -->
  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p class="copyright">{rightsNotice}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #1e293b;
    color: #cbd5e1;
    padding-top: 4rem;
    border-top: 1px solid #334155;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1.2fr;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo-wrapper {
    background: #ffffff;
    padding: 0.35rem;
    border-radius: var(--radius-sm, 0.375rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .footer-site-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .footer-about-text {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 42ch;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #334155;
    color: #ffffff;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .social-link:hover {
    background-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .footer-heading {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-link {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .footer-nav-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .contact-line {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .contact-link {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-bottom {
    background-color: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: 1.5rem;
  }

  .footer-bottom-container {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .copyright {
    color: #64748b;
    font-size: 0.875rem;
    margin: 0;
  }
</style>
