---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import { localePaths, getPage } from '../../lib/content';
import { useTranslations, getList, localizedPath, type Locale } from '../../i18n/utils';
import { org } from '../../data/site';

export const getStaticPaths = localePaths;

const { lang } = Astro.params;
const locale = lang as Locale;
const t = useTranslations(locale);
const page = await getPage(locale, 'contact');
const objectives = getList(locale, 'objectives');

// Google Maps embed URL with dynamic language switcher ('en' or 'ne')
const mapLang = locale === 'ne' ? 'ne' : 'en';
const mapQuery = 'National Mission Commission of Nepal, Kathmandu, Nepal';
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed&hl=${mapLang}`;
const mapSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---

<BaseLayout title={t('contact.title')} description={page?.data.description}>
  <HeroSection
    eyebrow={page?.data.heroEyebrow}
    title={page?.data.heroTitle ?? t('contact.heading')}
    subtitle={page?.data.heroSubtitle ?? t('contact.intro')}
  />

  <section class="section">
    <div class="container contact-layout">
      <!-- Web3Forms Contact Form Column -->
      <div class="contact-form-box card-box">
        <h2>{t('contact.form.title') || 'Send us a message'}</h2>
        <form id="form" class="contact-form">
          <input type="hidden" name="access_key" value="ee8c63ec-5c21-44e6-9472-a08f3075757e" />
          
          <div class="form-group">
            <label for="name">{t('contact.form.name') || 'Your Name'} *</label>
            <input type="text" id="name" name="name" required class="form-control" />
          </div>

          <div class="form-group">
            <label for="email">{t('contact.form.email') || 'Your Email'} *</label>
            <input type="email" id="email" name="email" required class="form-control" />
          </div>

          <div class="form-group">
            <label for="message">{t('contact.form.message') || 'Your Message'} *</label>
            <textarea id="message" name="message" rows="5" required class="form-control"></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">{t('contact.form.send') || 'Send Message'}</button>
          <div id="result" class="form-result"></div>
        </form>
      </div>

      <!-- Details Column -->
      <aside class="contact-details card-box">
        <h2>{t('contact.detailsTitle') || 'Contact Details'}</h2>
        <div class="detail-block">
          <h3>{t('contact.addressTitle') || 'Address'}</h3>
          <address>
            {org.name}<br />
            {org.poBox}<br />
            {org.city} {org.country}
          </address>
        </div>
        <div class="detail-block">
          <h3>{t('contact.registrationTitle') || 'Registration'}</h3>
          <ul class="reg-list">
            <li>{t('contact.govRegNo') || 'Government Registration No.'} <strong>{org.govRegNo}</strong></li>
            <li>{t('contact.panNo') || 'PAN No.'} <strong>{org.panNo}</strong></li>
            <li>{t('contact.swcNo') || 'SWC Affiliation No.'} <strong>{org.swcNo}</strong></li>
          </ul>
        </div>
        <div class="detail-block">
          <h3>{t('contact.phone') || 'Phone'} / {t('contact.email') || 'Email'}</h3>
          <p>
            <a href={`tel:${org.phoneHref}`}>{org.phone}</a><br />
            <a href={`mailto:${org.email}`}>{org.email}</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Centered 80% Width Map Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center">
        <h2>{t('contact.mapTitle')}</h2>
      </div>
      <div class="map-wrapper">
        <div class="map-placeholder" role="img" aria-label="Map showing National Mission Commission of Nepal in Kathmandu, Nepal">
          <iframe
            title="Map of National Mission Commission of Nepal, Kathmandu, Nepal"
            src={mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="map-actions" style="margin-top: 0.75rem; text-align: right;">
          <a href={mapSearchUrl} target="_blank" rel="noopener noreferrer" class="map-link">
            {t('contact.openInMaps') || 'Open in Maps'} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Section Styled into Cards -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2 help-grid">
        <div class="help-card">
          <span class="eyebrow">{org.shortName}</span>
          <h2>{t('contact.helpTitle')}</h2>
          <p class="lead">{t('contact.helpBody')}</p>
          <a href={localizedPath(locale, '/donate')} class="btn btn-primary">{t('nav.donate')}</a>
        </div>
        <div class="help-card">
          <h3>{t('contact.objectivesTitle')}</h3>
          <ul class="obj-list">
            {objectives.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("form") as HTMLFormElement;
  const result = document.getElementById("result") as HTMLElement;

  if (form && result) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      result.style.color = "#0b66c2";
      result.innerHTML = "Sending...";

      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: new FormData(form),
      });

      const data = await response.json();
      if (data.success) {
        result.style.color = "var(--color-success, #16a34a)";
        result.innerHTML = "Form Submitted Successfully";
        form.reset();
      } else {
        result.style.color = "#dc2626";
        result.innerHTML = data.message;
      }
    });
  }
</script>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .contact-layout { 
      grid-template-columns: 1fr 1fr; 
      align-items: stretch;
    }
  }
  .card-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .card-box h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-weight: 600;
    font-size: 0.95rem;
    color: #1e293b;
  }
  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius, 0.375rem);
    font-size: 1rem;
    color: #334155;
    background-color: #f8fafc;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(11, 102, 194, 0.15);
  }
  textarea.form-control {
    resize: vertical;
  }
  .submit-btn {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.85rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
  }
  .form-result {
    margin-top: 0.5rem;
    font-weight: 600;
    text-align: center;
    font-size: 0.95rem;
  }
  .detail-block { margin-bottom: 1.5rem; }
  .detail-block h3 { font-size: 1rem; color: var(--color-primary); margin-bottom: 0.4rem; }
  .contact-details address { font-style: normal; line-height: 1.8; }
  .reg-list, .obj-list { list-style: none; padding: 0; margin: 0; }
  .reg-list li { padding: 0.3rem 0; border-bottom: 1px solid var(--color-border); }
  .obj-list li {
    padding: 0.6rem 0 0.6rem 1.75rem;
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }
  .obj-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 800;
  }

  /* 80% Width Centered Map Container */
  .map-wrapper {
    width: 80%;
    margin-inline: auto;
  }
  .map-placeholder {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 7;
  }
  .map-placeholder iframe { width: 100%; height: 100%; border: 0; display: block; }
  .map-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .map-link:hover {
    text-decoration: underline;
    color: #084c91;
  }

  /* Standard Card Styling for Bottom Section */
  .help-grid { align-items: stretch; }
  .help-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .help-card h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 1rem;
  }
  .help-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 1rem;
  }
  .help-card p.lead {
    color: #475569;
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
</style>
