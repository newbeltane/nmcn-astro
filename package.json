{
  "name": "nmcn-nepal",
  "type": "module",
  "version": "1.0.0",
  "description": "National Mission Commission of Nepal - Astro website with TinaCMS",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tina:dev": "tinacms dev -c \"astro dev\"",
    "tina:build": "tinacms build && astro build",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/preact": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.1.1",
    "preact": "^10.25.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tinacms/cli": "^1.9.0",
    "@types/node": "^22.20.4",
    "tinacms": "^2.7.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
