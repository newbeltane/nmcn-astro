# ---------------------------------------------------------------------------
# NMCN Nepal — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# TinaCMS Cloud (https://app.tina.io) — required for the hosted /admin editor.
# Leave blank to run TinaCMS in local mode (`npm run tina:dev`).
TINA_CLIENT_ID=
TINA_TOKEN=
# Optional: TinaCMS search
TINA_SEARCH_TOKEN=

# Git branch TinaCMS reads/writes (defaults to "main").
GITHUB_BRANCH=main

# Cloudflare deployment (used by wrangler / GitHub Actions).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: contact form backend endpoint (Formspree, Cloudflare Worker, etc.).
# If unset, the form runs in demo mode and simulates a successful submission.
PUBLIC_CONTACT_ENDPOINT=
